# Personal config (DB credentials, API keys, decisions)
config.yml

# Downloaded sources and processed artifacts.
# `raw/` itself is allowed (so per-source dirs + manifest examples can be
# committed); only the actual downloaded payloads inside it are ignored.
raw/*/*
!raw/*/manifest.example.yml
processed/
logs/

# Cached HuggingFace datasets
.cache/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/

# Audio files generated by vectorize
*.wav
*.mp3

# Editor
.vscode/
.idea/
*.swp
.DS_Store
.env
