fra:siège__nom__1  rdf:type    ontolex:Word , ontolex:LexicalEntry;
        rdfs:label             "siège"@fr;
        dbnary:hypernym        fra:meuble;
        dbnary:hyponym         fra:balançoire , fra:banc , fra:banquette , fra:berceuse , fra:bergère , fra:boudeuse , fra:brouette , fra:cabriolet , fra:canapé , fra:caquetoire , fra:cathèdre , fra:causeuse , fra:chaire , fra:chaise , fra:chaise_curule , fra:chaise_longue , fra:chaise_percée , fra:chauffeuse , fra:clic-clac , fra:coffre , fra:coussin , fra:crapaud , fra:dagobert , fra:divan , fra:escabeau , fra:escarpolette , fra:estrade , fra:faldistoire , fra:fauteuil , fra:filanzane , fra:gradin , fra:marquise , fra:méridienne , fra:miséricorde , fra:montauban , fra:ottomane , fra:palanquin , fra:pliant , fra:pouf , fra:récamier , fra:rocking-chair , fra:séant , fra:selle , fra:sellette , fra:sofa , fra:stalle , fra:strapontin , fra:tabouret , fra:tan-sad , fra:tête-à-tête , fra:transat , fra:trépied , fra:trône , fra:vinaigrette , fra:voltaire , fra:voyeuse;
        dbnary:partOfSpeech    "-nom-";
        dbnary:synonym         fra:cul , fra:derrière , fra:fondement , fra:blocus;
        dcterms:language       lexvo:fra;
        lexinfo:partOfSpeech   lexinfo:noun;
        lime:language          "fr";
        ontolex:canonicalForm  fra:__cf_siège__nom__1;
        ontolex:sense          fra:__ws_1_siège__nom__1 , fra:__ws_2_siège__nom__1 , fra:__ws_3_siège__nom__1 , fra:__ws_4_siège__nom__1 , fra:__ws_5_siège__nom__1 , fra:__ws_6_siège__nom__1 , fra:__ws_7_siège__nom__1 , fra:__ws_8_siège__nom__1 , fra:__ws_9_siège__nom__1 , fra:__ws_10_siège__nom__1 , fra:__ws_11_siège__nom__1 , fra:__ws_12_siège__nom__1 .

fra:__cf_siège__nom__1
        rdf:type             ontolex:Form;
        lexinfo:gender       lexinfo:masculine;
        ontolex:phoneticRep  "sjɛʒ"@fr-fonipa;
        ontolex:writtenRep   "siège"@fr .

fra:siège  rdf:type       dbnary:Page;
        dbnary:describes  fra:siège__nom__1 .

fra:__ws_1_siège__nom__1
        rdf:type            ontolex:LexicalSense;
        dbnary:senseNumber  "1";
        skos:definition     [ rdf:value  "(Mobilier) Meuble utilisé pour s’asseoir."@fr ];
        skos:example        [ rdf:value                      "Sur deux sièges contigus sont assis Fulk Ephrinell et miss Horatia Bluett. Ils causent en crayonnant des chiffres."@fr;
                              dcterms:bibliographicCitation  "Jules Verne, Claudius Bombarnac, Claudius_Bombarnac/6, J. Hetzel et Cie, Paris, 1892"@fr
                            ];
        skos:example        [ rdf:value                      "Il prit un siège, alluma une cigarette et accepta sans se faire prier un verre de vin de messe."@fr;
                              dcterms:bibliographicCitation  "Albert Gervais, Æsculape dans la Chine en révolte, Gallimard, 1953, pages 32-33"@fr
                            ] .

fra:__ws_2_siège__nom__1
        rdf:type            ontolex:LexicalSense;
        dbnary:senseNumber  "2";
        skos:definition     [ rdf:value  "(Anatomie) Partie du corps sur laquelle on s’assied."@fr ];
        skos:example        [ rdf:value  "Bain de siège."@fr ];
        skos:example        [ rdf:value  "Le bébé s’est présenté par le siège : il est sorti par le bassin au lieu de la tête."@fr ];
        skos:example        [ rdf:value                      "Quand Berthier s’emportait contre les Dur et leurs allures de cafards, il avait toujours une injure de choix qui intéressait la région du siège, et l’intonation qu’il mettait dans le mot « réactionnaires » signifiait surtout son mépris pour des amours qu’il soupçonnait d’être ridicules."@fr;
                              dcterms:bibliographicCitation  "Marcel Aymé, La jument verte, Gallimard, 1933, collection Le Livre de Poche, page 203"@fr
                            ];
        skos:example        [ rdf:value                      "Mes parents attendaient un garçon, Jean-Baptiste. Naître par le siège fut ma manière de les avertir sans tarder de leur erreur, à une époque où l’on ne pratiquait pas l’échographie."@fr;
                              dcterms:bibliographicCitation  "Amélie Nothomb, La Nostalgie heureuse, Albin Michel, 2013, page 102"@fr
                            ] .

fra:__ws_3_siège__nom__1
        rdf:type            ontolex:LexicalSense;
        dbnary:senseNumber  "3";
        skos:definition     [ rdf:value  "(Justice) (Spécialement) Place où le juge s’assied pour rendre la justice."@fr ];
        skos:example        [ rdf:value  "Le juge étant sur son siège."@fr ];
        skos:example        [ rdf:value  "Allez au siège."@fr ] .

fra:__ws_4_siège__nom__1
        rdf:type            ontolex:LexicalSense;
        dbnary:senseNumber  "4";
        skos:definition     [ rdf:value  "(Justice) (Par hyperbole) (Vieilli) Lieu où l’on rendait la justice, dans les juridictions subalternes."@fr ];
        skos:example        [ rdf:value  "Vous le trouverez au siège."@fr ];
        skos:example        [ rdf:value  "Le ressort de ce siège était de telle étendue."@fr ] .

fra:__ws_5_siège__nom__1
        rdf:type            ontolex:LexicalSense;
        dbnary:senseNumber  "5";
        skos:definition     [ rdf:value  "(Justice) (Par extension) Corps et juridiction des juges subalternes."@fr ];
        skos:example        [ rdf:value  "C’était l’usage de tel siège."@fr ] .

fra:__ws_6_siège__nom__1
        rdf:type            ontolex:LexicalSense;
        dbnary:senseNumber  "6";
        skos:definition     [ rdf:value  "(Justice) (Par extension) Décision de justice."@fr ];
        skos:example        [ rdf:value                      "Les époux Nem se rembrunirent, mais ils tinrent leur langue, car à l’évidence, le siège du seigneur était fait."@fr;
                              dcterms:bibliographicCitation  "Robert Jordan, Les Feux du ciel, traduit par Jean-Claude Mallé, Bragelonne, 2013, ISBN 978-2-35294-664-9"@fr
                            ] .

fra:__ws_7_siège__nom__1
        rdf:type            ontolex:LexicalSense;
        dbnary:senseNumber  "7";
        skos:definition     [ rdf:value  "(Politique) Place (position) pour un représentant, obtenant généralement son mandat suite à une élection."@fr ];
        skos:example        [ rdf:value                      "S’il n’y a qu’une circonscription nationale, comprenant tous les sièges, et que ces sièges sont tous attribués au parti qui a obtenu le plus de votes, le système sera tout à fait disproportionnel."@fr;
                              dcterms:bibliographicCitation  "Vincent Lemieux, Systèmes partisans & partis politique, 1985, page 233"@fr
                            ];
        skos:example        [ rdf:value                      "La nouvelle ligne coûte cher au parti communiste français. Aux élections législatives de 1928, s’il perd treize sièges (quatorze élus au lieu de vingt-trois), il gagne 180 000 voix. Quatre ans plus tard, aux élections de 1932, il perd encore des sièges (seulement dix élus) et cette fois, il perd aussi 250 000 voix."@fr;
                              dcterms:bibliographicCitation  "Jacques Delpierrié de Bayac, Histoire du Front populaire, Fayard, 1972, page 22"@fr
                            ] .

fra:__ws_8_siège__nom__1
        rdf:type            ontolex:LexicalSense;
        dbnary:senseNumber  "8";
        skos:definition     [ rdf:value  "Endroit où est établi quelqu’un ou quelque chose."@fr ];
        skos:example        [ rdf:value                      "San Cristobal de la Laguna est le siège de l’évêque du diocèse de Ténériffe, de plusieurs couvents et établissements d’enseignement supérieur."@fr;
                              dcterms:bibliographicCitation  "Frédéric Weisgerber, Huit jours à Ténériffe, dans la Revue générale des sciences pures et appliquées, Paris : Doin, 1905, volume 16, page 1039"@fr
                            ];
        skos:example        [ rdf:value                      "Pessan, le siège d’une antique abbaye, a une superficie de 2588 hectares où végètent encore 430 habitants."@fr;
                              dcterms:bibliographicCitation  "Ludovic Naudeau, La France se regarde : Le Problème de la natalité, Librairie Hachette, Paris, 1931"@fr
                            ] .

fra:__ws_9_siège__nom__1
        rdf:type            ontolex:LexicalSense;
        dbnary:senseNumber  "9";
        skos:definition     [ rdf:value  "(En particulier) Lieu où se réunit la direction d’un gouvernement, d’une administration, d’une entreprise, etc."@fr ];
        skos:example        [ rdf:value  "Il faut envoyer cette lettre au siège social, qui est situé à Toulouse."@fr ];
        skos:example        [ rdf:value  "Le siège d’un tribunal, d’une cour."@fr ];
        skos:example        [ rdf:value  "Le siège du gouvernement."@fr ];
        skos:example        [ rdf:value  "Rome était le siège de l’Empire romain."@fr ];
        skos:example        [ rdf:value  "Le siège d’une société. → voir siège social"@fr ] .

fra:__ws_10_siège__nom__1
        rdf:type            ontolex:LexicalSense;
        dbnary:senseNumber  "10";
        skos:definition     [ rdf:value  "(En particulier) (Christianisme) Un évêché et sa juridiction. — → voir Saint-Siège."@fr ];
        skos:example        [ rdf:value                      "D’après les frères de Sainte-Marthe, un moine de l’ordre de Saint-Benoit aurait occupé, en 1421, le siège de Bethléem. Il s’agit ici ([…]), soit d’un prélat in partibus de Bethléem de Judée, soit d’un évêque espagnol de la création de l’antipape Benoit XIII."@fr;
                              dcterms:bibliographicCitation  "Louis Chevalier Lagenissière, Histoire de l’évêché de Bethléem, Paris : chez Dumoulin & Nevers : chez Michot, 1872, page 30"@fr
                            ];
        skos:example        [ rdf:value                      "Mais, pour que ne périsse pas la mémoire à tant de titres recommandable des trois sièges archiépiscopaux , savoir, Arles, Narbonne et Vienne en Dauphiné, dont l’érection n’a pas lieu, nous ordonnons d’ajouter leurs noms titulaires à d’autres sièges archiépiscopaux , […]."@fr;
                              dcterms:bibliographicCitation  "Jean-Baptiste Duvergier, Collection complète des lois, décrets, ordonnances, réglements et avis du Conseil d’État, 1828, volume 24, page 162"@fr
                            ] .

fra:__ws_11_siège__nom__1
        rdf:type            ontolex:LexicalSense;
        dbnary:senseNumber  "11";
        skos:definition     [ rdf:value  "(Sens figuré) Lieu où certaines choses résident principalement ; lieu où elles dominent."@fr ];
        skos:example        [ rdf:value                      "C’est à ces deux derniers effets de l’AIA que nous nous intéresserons principalement ici puisqu'ils concernent les racines, siège de la symbiose mycorhizienne."@fr;
                              dcterms:bibliographicCitation  "Jean Garbaye, La symbiose mycorhizienne : Une association entre les plantes et les champignons, Éditions Quae, 2013, page 88"@fr
                            ];
        skos:example        [ rdf:value                      "L’odorat, qui a pour siège les poils olfactifs est, chez lui, rudimentaire, et partiellement inhibé par la vision."@fr;
                              dcterms:bibliographicCitation  "Jean Rostand, La vie des crapauds, 1933"@fr
                            ];
        skos:example        [ rdf:value                      "La fièvre aphteuse (cocotte), grave chez les bovidés, peut être transmise à l’espèce humaine. Elle donne lieu alors à une stomatite caractérisée par la fièvre et une éruption de grosses vésicules qui ont pour siège d’élection la face dorsale de la langue."@fr;
                              dcterms:bibliographicCitation  "Docteur Gaston Variot, Traité d’hygiène infantile, Doin, 1910, page 300"@fr
                            ] .

fra:__ws_12_siège__nom__1
        rdf:type            ontolex:LexicalSense;
        dbnary:senseNumber  "12";
        skos:definition     [ rdf:value  "(Militaire) Action consistant à bloquer son adversaire dans son propre camp et attendre qu’il manque de ressources."@fr ];
        skos:example        [ rdf:value                      "Le siège de Toulouse de 1159 constitue le tournant de la « guerre de Cent Ans du XIIe siècle », qui vit s’affronter sur le terrain languedocien les grands princes européens, et marque le surgissement de motivations qui ne se limitent plus à des litiges territoriaux, mais qui commencent à impliquer de graves accusations d’hérésie, à l’origine des bouleversements politiques du XIIIe siècle."@fr;
                              dcterms:bibliographicCitation  "Hélène Débax, « 1159. La guerre pour Toulouse », Histoire mondiale de la France, sous la direction de Patrick Boucheron, Éditions du Seuil, 2017, réédition Points, collection Points Histoire, 2018, page 211"@fr
                            ];
        skos:example        [ rdf:value                      "Si les Spinaliens soutinrent vaillamment un siège contre Charles le Téméraire, il n’en fut pas de même, deux siècles plus tard, quand Louis XIV déploya contre eux ses forces […]."@fr;
                              dcterms:bibliographicCitation  "Gustave Fraipont; Les Vosges, 1895"@fr
                            ];
        skos:example        [ rdf:value                      "En 508, Clovis mit le siège devant Carcassonne et fut obligé de lever son camp sans avoir pu s’emparer de la ville."@fr;
                              dcterms:bibliographicCitation  "Eugène Viollet-le-Duc, La Cité de Carcassonne, 1888"@fr
                            ];
        skos:example        [ rdf:value                      "[…], il se résolut non à la retraite, mais à changer le siège en blocus, espérant être plus heureux pendant la nuit par un hardi coup de main, ou, en désespoir de cause, certain de réduire tôt ou tard les assiégés par la famine."@fr;
                              dcterms:bibliographicCitation  "Gustave Aimard, Les Trappeurs de l’Arkansas, Éditions Amyot, Paris, 1858"@fr
                            ] .

