fra:manga__nom__1  rdf:type    ontolex:Word , ontolex:LexicalEntry;
        rdfs:label             "manga"@fr;
        dbnary:hypernym        fra:bande_dessinée , fra:BD;
        dbnary:partOfSpeech    "-nom-";
        dcterms:language       lexvo:fra;
        lexinfo:partOfSpeech   lexinfo:noun;
        lime:language          "fr";
        ontolex:canonicalForm  fra:__cf_manga__nom__1;
        ontolex:sense          fra:__ws_1_manga__nom__1 , fra:__ws_2_manga__nom__1 , fra:__ws_3_manga__nom__1 .

fra:__cf_manga__nom__1
        rdf:type             ontolex:Form;
        lexinfo:gender       lexinfo:masculine;
        ontolex:phoneticRep  "mɑ̃.ɡa"@fr-fonipa;
        ontolex:writtenRep   "manga"@fr .

fra:manga  rdf:type       dbnary:Page;
        dbnary:describes  fra:manga__nom__1 .

fra:__ws_1_manga__nom__1
        rdf:type            ontolex:LexicalSense;
        dbnary:senseNumber  "1";
        skos:definition     [ rdf:value  "(Bande dessinée, Fiction japonaise) Bande dessinée japonaise, souvent en noir et blanc."@fr ];
        skos:example        [ rdf:value                      "Les illustrateurs de l’atelier rémois 510 TTC choisis par l’agence de publicité se sont fait connaître en travaillant notamment sur les aventures du jeune héros Akira, de Katsuhiro Otomo, l’un des premiers mangas (avec Dragon Ball) à entrer en Europe en 1989."@fr;
                              dcterms:bibliographicCitation  "Florence Amalou, La bande dessinée se met au service des publicitaires, Le Monde,  12 janvier 1999"@fr
                            ] .

fra:__ws_2_manga__nom__1
        rdf:type            ontolex:LexicalSense;
        dbnary:senseNumber  "2";
        skos:definition     [ rdf:value  "(Bande dessinée, Fiction japonaise) Style, stéréotypes et règles implicites de la bande dessinée japonaise."@fr ];
        skos:example        [ rdf:value  "Certaines caractéristiques du manga proviennent de l’influence des films de Walt Disney sur Osamu Tezuka."@fr ];
        skos:example        [ rdf:value                      "En ce moment, je lis des mangas de Taniguchi, un génie qui m’apprend beaucoup de choses sur les hommes."@fr;
                              dcterms:bibliographicCitation  "Muriel Barbery, L’Élégance du hérisson, Gallimard, collection « Folio », 2006, page 113"@fr
                            ] .

fra:__ws_3_manga__nom__1
        rdf:type            ontolex:LexicalSense;
        dbnary:senseNumber  "3";
        skos:definition     [ rdf:value  "(Audiovisuel) Dessin animé japonais ; anime."@fr ];
        skos:example        [ rdf:value                      "Hier soir, juste au moment où j’allais me coucher, je suis tombée sur un programme télévisé, un manga plus précisément qui m’a emmené loin de mes tracas du quotidien."@fr;
                              dcterms:bibliographicCitation  "Carole Luna, Témoignage d’une femme à bout de force, 2008"@fr
                            ];
        skos:example        [ rdf:value                      "Dans l’univers des mangas, sont également hybrides les nombreux robots : mecha — robots animés —, cyborgs et autres « transhumains » aux formes fragiles transformés en corps puissants."@fr;
                              dcterms:bibliographicCitation  "Joëlle Nouhet-Roseman, Les mangas pour jeunes filles, figures du sexuel à l’adolescence, Éditions Eres, 2011"@fr
                            ];
        skos:example        [ rdf:value                      "Né à Tōkyō en 1941, il débute sa carrière comme intervalliste dans les célèbres studios d’animation Tôei, d’où sortent les plus grands mangas japonais."@fr;
                              dcterms:bibliographicCitation  "Petit Futé : Japon, 2013–2014, page 68"@fr
                            ] .

