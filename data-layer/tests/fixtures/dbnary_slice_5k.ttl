fra:accueil__nom__1  rdf:type  ontolex:Word , ontolex:LexicalEntry;
        rdfs:label             "accueil"@fr;
        dbnary:partOfSpeech    "-nom-";
        dbnary:synonym         <http://kaiko.getalp.org/dbnary/fra/page_d’accueil> , fra:home , fra:main_page;
        dcterms:language       lexvo:fra;
        lexinfo:partOfSpeech   lexinfo:noun;
        lime:language          "fr";
        ontolex:canonicalForm  fra:__cf_accueil__nom__1;
        ontolex:sense          fra:__ws_1_accueil__nom__1 , fra:__ws_2_accueil__nom__1 , fra:__ws_3_accueil__nom__1 , fra:__ws_4_accueil__nom__1 , fra:__ws_5_accueil__nom__1 .

fra:__cf_accueil__nom__1
        rdf:type             ontolex:Form;
        lexinfo:gender       lexinfo:masculine;
        ontolex:phoneticRep  "a.kœj"@fr-fonipa;
        ontolex:writtenRep   "accueil"@fr .

fra:accueil  rdf:type     dbnary:Page;
        dbnary:describes  fra:accueil__nom__1 .

fra:__ws_1_accueil__nom__1
        rdf:type            ontolex:LexicalSense;
        dbnary:senseNumber  "1";
        skos:definition     [ rdf:value  "Cérémonie ou prestation réservée à un nouvel arrivant, consistant généralement à lui souhaiter la bienvenue et à l’aider dans son intégration ou ses démarches."@fr ];
        skos:example        [ rdf:value                      "Nous réservâmes aux nouveaux venus un accueil qui fut cordial et empressé, mais le temps n’était pas aux effusions et d’un commun avis, il fallait agir vite."@fr;
                              dcterms:bibliographicCitation  "Jean-Baptiste Charcot, Dans la mer du Groenland, 1928"@fr
                            ];
        skos:example        [ rdf:value                      "Partout elle avait trouvé bon accueil, prompt assentiment, mais elle se propose d’aller plus outre."@fr;
                              dcterms:bibliographicCitation  "Jean Rogissart, Passantes d’Octobre, Librairie Arthème Fayard, Paris, 1958"@fr
                            ];
        skos:example        [ rdf:value                      "Notre hôte, absent au moment de notre arrivée, ne tarde pas à paraître et me fait l’accueil auquel je m'attendais de sa part."@fr;
                              dcterms:bibliographicCitation  "Frédéric Weisgerber, Trois mois de campagne au Maroc : étude géographique de la région parcourue, Paris : Ernest Leroux, 1904, page 38"@fr
                            ] .

fra:__ws_2_accueil__nom__1
        rdf:type            ontolex:LexicalSense;
        dbnary:senseNumber  "2";
        skos:definition     [ rdf:value  "Lieu où sont accueillies les personnes."@fr ];
        skos:example        [ rdf:value  "À l’accueil, ils t’expliqueront comment aller à son bureau."@fr ] .

fra:__ws_3_accueil__nom__1
        rdf:type            ontolex:LexicalSense;
        dbnary:senseNumber  "3";
        skos:definition     [ rdf:value  "(Vieilli) Fait d’accueillir ou héberger."@fr ];
        skos:example        [ rdf:value                      "Le Maire rappelle au conseil municipal que l’accueil périscolaire aura lieu à la rentrée de septembre 2008–2009 dans la salle de réunions et le petit local attenant."@fr;
                              dcterms:bibliographicCitation  "Le Chesne, Conseil municipal du 27 juin 2008"@fr
                            ] .

fra:__ws_4_accueil__nom__1
        rdf:type            ontolex:LexicalSense;
        dbnary:senseNumber  "4";
        skos:definition     [ rdf:value  "Page d’accès ou d’accueil (lieu ci-dessus) à un site web."@fr ] .

fra:__ws_5_accueil__nom__1
        rdf:type            ontolex:LexicalSense;
        dbnary:senseNumber  "5";
        skos:definition     [ rdf:value  "Manière dont une œuvre a été acceptée lors de sa sortie par le public et les critiques."@fr ] .

