        lexinfo:verbFormMood  lexinfo:infinitive;
        ontolex:phoneticRep   "liʁ"@fr-fonipa;
        ontolex:writtenRep    "lire"@fr .

fra:lire  rdf:type        dbnary:Page;
        dbnary:describes  fra:lire__verb__1 , fra:lire__nom__1 .

fra:__ws_1_lire__verb__1
        rdf:type            ontolex:LexicalSense;
        dbnary:senseNumber  "1";
        skos:definition     [ rdf:value  "Interpréter des informations écrites sous forme de mots ou de dessins sur un support."@fr ];
        skos:example        [ rdf:value                      "On lit ce livre absolument comme au bord de la cascade on entendrait, rêveur, le gazouillement des eaux."@fr;
                              dcterms:bibliographicCitation  "Jules Michelet, Du prêtre, de la femme, de la famille, 3e éd., Hachette & Paulin, 1845, page 133"@fr
                            ];
        skos:example        [ rdf:value                      "Ceux qui ne savent pas lire connaissent au moins certaines lettres qui les guident, ou, s’ils ne les connaissent pas, ils en remarquent la forme et l’arrangement avec la sûreté d’observation qui aide le sauvage à retrouver sa direction dans la forêt vierge."@fr;
                              dcterms:bibliographicCitation  "George Sand, Journal d'un voyageur pendant la guerre, 1871, page 289"@fr
                            ];
        skos:example        [ rdf:value                      "[…] ; je me souviens d’avoir lu autrefois, dans un manuel de Paul Bert, que le principe fondamental de la morale s’appuie sur les enseignements de Zoroastre et sur la Constitution de l’an III ; […]."@fr;
                              dcterms:bibliographicCitation  "Georges Sorel, Réflexions sur la violence, chapitre VII, La morale des producteurs, 1908, page 315"@fr
                            ];
        skos:example        [ rdf:value                      "[…], mais vous comprenez bien qu’on ne donne pas une égale attention à tout ce qu’on lit ou qu’on parcourt dans les colonnes des journaux […]."@fr;
                              dcterms:bibliographicCitation  "Louis Pergaud, Un point d’histoire, dans Les Rustiques, nouvelles villageoises, 1921"@fr
                            ];
        skos:example        [ rdf:value                      "Il était célèbre par une obstination admirable à apprendre à écrire et à lire ; le résultat ne fut pas étonnant ; il faut croire qu’il est bien difficile d’apprendre à lire ; […]."@fr;
                              dcterms:bibliographicCitation  "Alain, Souvenirs de guerre, Hartmann, 1937, page 75"@fr
                            ];
        skos:example        [ rdf:value                      "Mais lire, c’est surtout entrer en soi-même, apprendre à se considérer comme un monde de signes, de messages codés, de rébus."@fr;
                              dcterms:bibliographicCitation  "Philippe Sollers, Éloge de l’infini, Gallimard, page 619"@fr
                            ];
        skos:example        [ rdf:value                      "Le verbe lire ne supporte pas l’impératif. Aversion qu’il partage avec quelques autres ; le verbe « aimer »… le verbe « rêver »…On peut toujours essayer, bien sûr. Allez-y : « Aime-moi ! » « Rêve ! » « Lis ! » « Lis ! Mais lis donc, bon sang, je t’ordonne de lire ! »— Monte dans ta chambre et lis !Résultat ?Néant."@fr;
                              dcterms:bibliographicCitation  "Daniel Pennac, Comme un roman, Gallimard, 1992, page 13"@fr
                            ];
        skos:example        [ rdf:value                      "Une caméra embarquée sera capable de \"lire\" les panneaux de signalisation ou les données cartographiques du GPS et les comparer avec la vitesse du véhicule avant d’avertir le conducteur s’il dépasse la limitation de vitesse."@fr;
                              dcterms:bibliographicCitation  "Cyril Brioulet, Toutes les voitures neuves sauront \"lire\" les panneaux et vous inciter à ralentir, à partir du 1er juillet, La Dépêche du Midi, 19 mai 2024"@fr
                            ] .

fra:__ws_2_lire__verb__1
        rdf:type            ontolex:LexicalSense;
        dbnary:senseNumber  "2";
        skos:definition     [ rdf:value  "Suivre des yeux ce qui est écrit ou imprimé, avec la connaissance des sons que les lettres figurent ; soit en ne proférant pas les mots, soit en les proférant à haute voix."@fr ];
        skos:example        [ rdf:value                      "Ce qui m’étonne, c’est que le propriétaire dudit bouquin ne semble pas le lire de droite à gauche. Est-ce qu’il ne serait pas imprimé en caractères chinois ?"@fr;
                              dcterms:bibliographicCitation  "Jules Verne, Claudius Bombarnac, Claudius_Bombarnac/6, J. Hetzel et Cie, Paris, 1892"@fr
                            ];
        skos:example        [ rdf:value                      "Devenue totalement sourde, cette cagole de Catherine ne leur prêtait nulle attention. Un mince sourire flottait sur son visage et elle lisait."@fr;
                              dcterms:bibliographicCitation  "Maurice Lemoine, Les cités interdites, Éditions de l'Encre, 1987, page 129"@fr
                            ] .

fra:__ws_3_lire__verb__1
        rdf:type            ontolex:LexicalSense;
        dbnary:senseNumber  "3";
        skos:definition     [ rdf:value  "Prendre connaissance et comprendre un texte écrit."@fr ];
        skos:example        [ rdf:value                      "Il est de jeunes écrivains qui ne lisent pas Hugo. C’est pourquoi ils ont tant de certitudes heureuses et atteignent promptement au talent."@fr;
                              dcterms:bibliographicCitation  "Victor Méric, Les Compagnons de l’Escopette, Éditions de l’Épi, Paris, 1930, page 67"@fr
                            ];
        skos:example        [ rdf:value                      "J’ai beaucoup lu sur Péguy, ce fils de rempailleuse de chaises devenu Normalien, dreyfusard acharné, socialiste de sang et de flammes, polémiste frontal."@fr;
                              dcterms:bibliographicCitation  "François-Xavier Putallaz, Nicolas Buttet et Pascal Décaillet, Coups de griffe: chroniques des Temps qui courent, Éditions Saint-Augustin, 2006, page 219"@fr
                            ];
        skos:example        [ rdf:value                      "Il est vrai qu'il paraît inutile d'apprendre ce qui est écrit dans les livres puisque ça y est, encore faut il pouvoir l'y trouver et donc de savoir lire, privilège maintenant réservé à une frange minoritaire de la population qui a la chance de naître dans une famille […], ayant le souci et la patience d'apprendre la lecture à sa progéniture."@fr;
                              dcterms:bibliographicCitation  "Jean-Claude Besso, Les Commentaires du docteur Agasse, Société des Écrivains, 2010, page 55"@fr
                            ] .

fra:__ws_4_lire__verb__1
        rdf:type            ontolex:LexicalSense;
        dbnary:senseNumber  "4";
        skos:definition     [ rdf:value  "Comprendre ce qui est écrit ou imprimé dans une langue étrangère."@fr ];
        skos:example        [ rdf:value  "Il ne parle pas l’anglais, mais il le lit avec assez de facilité."@fr ] .

fra:__ws_5_lire__verb__1
        rdf:type            ontolex:LexicalSense;
        dbnary:senseNumber  "5";
        skos:definition     [ rdf:value  "(Musique) (Par analogie) Parcourir des yeux une musique notée, avec la connaissance des sons que les notes figurent et des diverses modifications que ces sons doivent recevoir."@fr ];
        skos:example        [ rdf:value                      "Une recette, c’est comme une partition. La musicienne lit les notes qui se présentent à elle et, simultanément, elle en entend la mélodie : les voir c’est les entendre, avant même de les jouer."@fr;
                              dcterms:bibliographicCitation  "Françoise Vergès, À vos mangues !, traduction de Dominique Malaquais, dans Politique africaine, 2005/4, no 100, page 319"@fr
                            ] .

fra:__ws_6_lire__verb__1
        rdf:type            ontolex:LexicalSense;
        dbnary:senseNumber  "6";
        skos:definition     [ rdf:value  "Prononcer à haute voix, avec l’intonation voulue, ce qui est écrit ou imprimé."@fr ];
        skos:example        [ rdf:value  "Il lit bien, il lit mal."@fr ];
        skos:example        [ rdf:value  "Il lit distinctement."@fr ];
        skos:example        [ rdf:value  "Il ne sait pas lire."@fr ];
        skos:example        [ rdf:value  "Il nous a lu un long discours."@fr ];
        skos:example        [ rdf:value  "Je vais vous lire mes vers."@fr ];
        skos:example        [ rdf:value  "Ce prince avait l’habitude de se faire lire quelque bon livre pendant ses repas."@fr ] .

fra:__ws_7_lire__verb__1
        rdf:type            ontolex:LexicalSense;
        dbnary:senseNumber  "7";
        skos:definition     [ rdf:value  "S’instruire, s’amuser, s’informer, etc. par la lecture."@fr ];
        skos:example        [ rdf:value  "Lire un volume de vers, un roman, un billet, une lettre, la messe, une dépêche chiffrée."@fr ];
        skos:example        [ rdf:value  "(Absolument) Il passe son temps à lire."@fr ];
        skos:example        [ rdf:value                      "(Absolument) Lire n'est pas du temps pris à la vie : c'est vivre plus."@fr;
                              dcterms:bibliographicCitation  "Dominique Lebel, L'entre-deux-mondes, Montréal, Boréal, 2019, page 109"@fr
                            ];
        skos:example        [ rdf:value  "(Sens figuré) C’est un ouvrage qu’on ne peut lire, se dit d’un ouvrage ennuyeux, ou mal écrit, ou surtout licencieux."@fr ];
        skos:example        [ rdf:value  "(Sens figuré) (Familier) Ce livre, cet ouvrage se laisse lire, On le lit sans fatigue, sans ennui."@fr ] .

fra:__ws_8_lire__verb__1
        rdf:type            ontolex:LexicalSense;
        dbnary:senseNumber  "8";
        skos:definition     [ rdf:value  "Se dit encore en parlant de quelque livre qu’un professeur explique ou fait expliquer à ses auditeurs et qu’il prend pour sujet des leçons qu’il leur donne."@fr ];
        skos:example        [ rdf:value  "Notre professeur nous lisait Homère."@fr ] .

fra:__ws_9_lire__verb__1
        rdf:type            ontolex:LexicalSense;
        dbnary:senseNumber  "9";
        skos:definition     [ rdf:value  "(Sens figuré) Comprendre par l'observation un sens caché qui est au-delà des apparences."@fr ];
        skos:example        [ rdf:value                      "L’ivresse se lisait dans ses yeux, une ivresse crâne et satisfaite qui lui arrachait quelquefois de gros rires."@fr;
                              dcterms:bibliographicCitation  "Francis Carco, Messieurs les vrais de vrai,  Les Éditions de France, Paris, 1927"@fr
                            ];
        skos:example        [ rdf:value                      "A quoi songes-tu donc ? s’informa la maîtresse du logis, surprise de l’inattention qu’elle lisait dans les yeux de l’artiste. Tu n’as pas de contrariétés."@fr;
                              dcterms:bibliographicCitation  "Francis Carco, L’Homme de minuit,  Éditions Albin Michel, Paris, 1938"@fr
                            ];
        skos:example        [ rdf:value                      "De temps à autre, elle regardera dehors et fera la lippe. Je lirai dans ses yeux ce que je lis dans les yeux de tous. L'ennui."@fr;
                              dcterms:bibliographicCitation  "Marcel Godin, Ce maudit soleil, Éditions Robert Laffont, 1965, chapitre 1"@fr
                            ];
        skos:example        [ rdf:value                      "Je la regardais — minutes silencieuses où l'on n'entendait que le tic-tac de l'horloge accrochée au mur — et j'essayais de lire dans son visage muet, mais rien d'elle ne m'était familier."@fr;
                              dcterms:bibliographicCitation  "Stefan Zweig, La peur, traduit de l'allemand par Alzir Hella, éditions Grasset, 1935, 2002"@fr
                            ];
        skos:example        [ rdf:value                      "Après tout, si on peut lire un dessin, lire les lignes de la main, lire dans le ciel le mauvais temps qui se prépare, ou lire les pensées dans le visage du renfrogné qui n'a pas ouvert la bouche, pourquoi ne pourrait-on apprendre à lire ce qui n'est écrit qu'entre les lignes?"@fr;
                              dcterms:bibliographicCitation  "Antonine Maillet, Clin d’œil au Temps qui passe, Leméac, 2019, page 159"@fr
                            ] .

fra:__ws_10_lire__verb__1
        rdf:type            ontolex:LexicalSense;
        dbnary:senseNumber  "10";
        skos:definition     [ rdf:value  "(Informatique) Lancer un fichier vidéo ou audio pour le regarder ou l’écouter."@fr ] .

