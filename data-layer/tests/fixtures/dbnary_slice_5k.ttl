fra:encyclopédie__nom__1
        rdf:type               ontolex:Word , ontolex:LexicalEntry;
        rdfs:label             "encyclopédie"@fr;
        dbnary:partOfSpeech    "-nom-";
        dcterms:language       lexvo:fra;
        lexinfo:partOfSpeech   lexinfo:noun;
        lime:language          "fr";
        ontolex:canonicalForm  fra:__cf_encyclopédie__nom__1;
        ontolex:sense          fra:__ws_1_encyclopédie__nom__1 , fra:__ws_2_encyclopédie__nom__1 , fra:__ws_3_encyclopédie__nom__1 , fra:__ws_4_encyclopédie__nom__1;
        vartrans:lexicalRel    [ rdf:type               ontolex:LexicalEntry;
                                 ontolex:canonicalForm  [ ontolex:writtenRep
                                                   "encyclopædie (archaïque)"@fr ]
                               ] .

fra:__cf_encyclopédie__nom__1
        rdf:type             ontolex:Form;
        lexinfo:gender       lexinfo:feminine;
        ontolex:phoneticRep  "ɑ̃.si.klɔ.pe.di"@fr-fonipa;
        ontolex:writtenRep   "encyclopédie"@fr .

fra:encyclopédie  rdf:type  dbnary:Page;
        dbnary:derivedFrom  fra:cycle__nom__1;
        dbnary:describes    fra:encyclopédie__nom__1 .

fra:__ws_1_encyclopédie__nom__1
        rdf:type            ontolex:LexicalSense;
        dbnary:senseNumber  "1";
        skos:definition     [ rdf:value  "Ensemble, enchaînement de toutes les connaissances."@fr ];
        skos:example        [ rdf:value                      "L’Encyclopédie aristotélicienne apparut comme la somme de connaissances humaines auxquelles l’esprit humain peut accéder par ses propres forces."@fr;
                              dcterms:bibliographicCitation  "Louis Rougier, Histoire d’une faillite philosophique: la Scolastique, 1925, édition 1966"@fr
                            ];
        skos:example        [ rdf:value  "Il est impossible qu’un seul homme possède l’encyclopédie du savoir humain."@fr ];
        skos:example        [ rdf:value                      "ENCYCLOPÉDIE, s.f. (Philosophie). Ce mot signifie « enchaînement de connaissances »."@fr;
                              dcterms:bibliographicCitation  "Denis Diderot, Article « ENCYCLOPÉDIE »"@fr
                            ] .

fra:__ws_2_encyclopédie__nom__1
        rdf:type            ontolex:LexicalSense;
        dbnary:senseNumber  "2";
        skos:definition     [ rdf:value  "Ouvrage où l'on tente de traiter exhaustivement de l’ensemble du savoir."@fr ];
        skos:example        [ rdf:value  "L’ouvrage de Pline l’Ancien est une véritable encyclopédie."@fr ] .

fra:__ws_3_encyclopédie__nom__1
        rdf:type            ontolex:LexicalSense;
        dbnary:senseNumber  "3";
        skos:definition     [ rdf:value  "Ouvrage qui traite systématiquement d’un ou plusieurs domaines des connaissances."@fr ];
        skos:example        [ rdf:value  "L’encyclopédie Wikipédia contient un article sur les montagnes Rocheuses."@fr ];
        skos:example        [ rdf:value  "Diderot et d’Alembert ont publié « L’Encyclopédie ou Dictionnaire raisonné des sciences, des arts et des métiers »."@fr ];
        skos:example        [ rdf:value                      "– Laissez le texte, dit le représentant, et regardez les images. Mon encyclopédie de l’art est d’un grand secours pour les soirées d’hiver. C’est un soutien moral."@fr;
                              dcterms:bibliographicCitation  "Daniel Boulanger, Le chemin des caracoles, Laffont, 1966, réédition Le Livre de Poche, page 75"@fr
                            ];
        skos:example        [ rdf:value                      "[…] mais aussi à cause d’un livre de son père, qu’il avait trouvé dans ses cartons, qui se voulait une encyclopédie définitive du parler gaga – le dialecte stéphanois – et qui lui avait causé un fou rire d’une demi-heure auquel Zoran ne comprenait pas grand-chose sinon qu’il fallait qu’il s’amuse lui aussi."@fr;
                              dcterms:bibliographicCitation  "Sabri Louatah, Les Sauvages, tome 1, Éditions Versilio, 2012, chap. 2, §. 1"@fr
                            ] .

fra:__ws_4_encyclopédie__nom__1
        rdf:type            ontolex:LexicalSense;
        dbnary:senseNumber  "4";
        skos:definition     [ rdf:value  "(Sens figuré) Personne semblant posséder un savoir universel, adepte du savoir encyclopédique."@fr ];
        skos:example        [ rdf:value                      "Lettré, théologien, juriste et philosophe, il est le type parfait, très rare aujourd’hui, du savant arabe : véritable encyclopédie vivante de la science d’il y a un demi-millénaire. Il croit fermement aux horoscopes, à l’influence des planètes et des constellations, des « douze maisons » du soleil, à la pierre philosophale et à la possibilité de transformer les métaux vils en métaux précieux."@fr;
                              dcterms:bibliographicCitation  "Frédéric Weisgerber, Trois mois de campagne au Maroc : étude géographique de la région parcourue, Paris : Ernest Leroux, 1904, page 122"@fr
                            ];
        skos:example        [ rdf:value                      "Copeland, surnommé Copland parce que c’était une encyclopédie ambulante de l’univers des flics, m’avait appris à peu près tout ce que je savais, et il avait été responsable de ma rapide ascension jusqu’à ce que je devienne le plus jeune chef de la criminelle jamais nommé."@fr;
                              dcterms:bibliographicCitation  "Tony Cavanaugh, L’Affaire Isobel Vine, traduit de l’anglais australien par Fabrice Pointeau, Sonatine Éditions, 2017, page 16."@fr , ""@fr
                            ] .

