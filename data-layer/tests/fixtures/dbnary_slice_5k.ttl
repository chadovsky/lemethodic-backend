fra:ouvrage__nom__1  rdf:type  ontolex:Word , ontolex:LexicalEntry;
        rdfs:label             "ouvrage"@fr;
        dbnary:partOfSpeech    "-nom-";
        dcterms:language       lexvo:fra;
        lexinfo:partOfSpeech   lexinfo:noun;
        lime:language          "fr";
        ontolex:canonicalForm  fra:__cf_ouvrage__nom__1;
        ontolex:sense          fra:__ws_1_ouvrage__nom__1 , fra:__ws_2_ouvrage__nom__1 , fra:__ws_3_ouvrage__nom__1 , fra:__ws_4_ouvrage__nom__1 , fra:__ws_5_ouvrage__nom__1 , fra:__ws_6_ouvrage__nom__1 , fra:__ws_7_ouvrage__nom__1 , fra:__ws_8_ouvrage__nom__1 .

fra:__cf_ouvrage__nom__1
        rdf:type             ontolex:Form;
        lexinfo:gender       lexinfo:masculine;
        ontolex:phoneticRep  "u.vʁaʒ"@fr-fonipa;
        ontolex:writtenRep   "ouvrage"@fr .

fra:ouvrage  rdf:type       dbnary:Page;
        dbnary:derivedFrom  fra:édition__nom__1;
        dbnary:describes    fra:ouvrage__nom__1 .

fra:__ws_1_ouvrage__nom__1
        rdf:type            ontolex:LexicalSense;
        dbnary:senseNumber  "1";
        skos:definition     [ rdf:value  "(Sens propre) Travail ; action de travailler."@fr ];
        skos:example        [ rdf:value                      "Le sophisme que je combats dans cet écrit est d’autant plus dangereux, appliqué aux travaux publics, qu’il sert à justifier les entreprises et les prodigalités les plus folles. Quand un chemin de fer ou un pont ont une utilité réelle, il suffit d’invoquer cette utilité. Mais si on ne le peut, que fait-on ? On a recours à cette mystification : « Il faut procurer de l’ouvrage aux ouvriers. »"@fr;
                              dcterms:bibliographicCitation  "Frédéric Bastiat, Ce qu’on voit et ce qu’on ne voit pas, 1850"@fr
                            ];
        skos:example        [ rdf:value                      "Deux ouvrages quotidiens désagréables sont déjà en train de disparaître."@fr;
                              dcterms:bibliographicCitation  "H. G. Wells, Anticipations, 1901, traduction d’Henry-D. Davray et B. Kozakiewicz, Société du Mercure de France, Paris, 1904"@fr
                            ];
        skos:example        [ rdf:value                      "Ça donne de l’ouvrageÀ tous les ouvriersEt chacun envisageDe fonder un foyer"@fr;
                              dcterms:bibliographicCitation  "Boris Vian, Le Petit Commerce, 1955"@fr
                            ] .

fra:__ws_2_ouvrage__nom__1
        rdf:type            ontolex:LexicalSense;
        dbnary:senseNumber  "2";
        skos:definition     [ rdf:value  "(Par métonymie) Résultat d’un travail, comme ce qui est produit par l’ouvrier."@fr ];
        skos:example        [ rdf:value  "Ouvrage de marqueterie, de mosaïque. Ouvrage de tapisserie, de broderie. Ouvrage de peinture, de sculpture, d’architecture."@fr ] .

fra:__ws_3_ouvrage__nom__1
        rdf:type            ontolex:LexicalSense;
        dbnary:senseNumber  "3";
        skos:definition     [ rdf:value  "(Sens figuré) (Par hyperbole) Résultat, généralement d'une action."@fr ];
        skos:example        [ rdf:value  "Ce succès fut l’ouvrage du hasard, de la fortune."@fr ];
        skos:example        [ rdf:value  "Mes malheurs ont été votre ouvrage."@fr ] .

fra:__ws_4_ouvrage__nom__1
        rdf:type            ontolex:LexicalSense;
        dbnary:senseNumber  "4";
        skos:definition     [ rdf:value  "(Absolument) (Couture) (Vieilli) Objet auquel les femmes travaillent à l’aiguille."@fr ];
        skos:example        [ rdf:value                      "Pour se donner une contenance, elle emportait d’ordinaire un tricot, un ouvrage de femme. Ses mains fiévreuses tremblaient en maniant les aiguilles."@fr;
                              dcterms:bibliographicCitation  "Émile Moselly, Terres lorraines, 1907"@fr
                            ];
        skos:example        [ rdf:value                      "Marie-Emilienne, tenant à la main l’ouvrage auquel elle venait de travailler, une nappe d’autel pour l’oeuvre des églises dévastées, demeurait immobile et silencieuse ; son expressif visage témoignait des sentiments divers et contraires qui l’agitaient."@fr;
                              dcterms:bibliographicCitation  "Comtesse de Massacré, L’autre courage, in Les veillées des chaumières no 42 du 26 mars 1919, page 330"@fr
                            ];
        skos:example        [ rdf:value  "Elle avait toujours son ouvrage à la main."@fr ] .

fra:__ws_5_ouvrage__nom__1
        rdf:type            ontolex:LexicalSense;
        dbnary:senseNumber  "5";
        skos:definition     [ rdf:value  "(En particulier) Production de l’esprit."@fr ];
        skos:example        [ rdf:value  "La législation d’Athènes fut l’ouvrage de Solon. Les ouvrages de Cicéron, de Virgile."@fr ] .

fra:__ws_6_ouvrage__nom__1
        rdf:type            ontolex:LexicalSense;
        dbnary:senseNumber  "6";
        skos:definition     [ rdf:value  "(Par extension) Recueil, livre qui contient ces productions de l’esprit."@fr ];
        skos:example        [ rdf:value                      "Il fera certainement de bons ouvrages, moyennant quoi il mourra de faim, sera honni et persécuté ; mais il faut que chacun remplisse sa destinée."@fr;
                              dcterms:bibliographicCitation  "Voltaire, Lettre à Monsieur de Cideville, Ferney, 31 auguste 1765, dans Œuvres complètes de Voltaire : Correspondance, Paris, Lefebvre & Cie, 1830, volume 10, page 29"@fr
                            ];
        skos:example        [ rdf:value                      "Je n’insiste pas, car il existe des ouvrages sur ces questions, tels l’important mémoire de De Candolle et les travaux de A. Chevalier."@fr;
                              dcterms:bibliographicCitation  "Henri Gaussen, Géographie des Plantes, Armand Colin, 1933, page 97"@fr
                            ];
        skos:example        [ rdf:value                      "Eh ! bien, ne reculant devant aucune tâche si fastidieuse fût-elle, ils pourvoiront, d’eux-mêmes, à la diffusion de ces ouvrages, en s’en faisant les traducteurs."@fr;
                              dcterms:bibliographicCitation  "Léon Berman, Histoire des Juifs de France des origines à nos jours, 1937"@fr
                            ];
        skos:example        [ rdf:value                      "Une longue fréquentation des ouvrages ésotériques m’a souvent fait croiser des ouvrages bourrés d’affirmations non vérifiées et contraires à toute démarche scientifique, garnis de citations introuvables, […]."@fr;
                              dcterms:bibliographicCitation  "« Les grands esprits manipulés par les astrologues », dans Le Québec sceptique, no 56, p. 29, printemps 2005"@fr
                            ] .

fra:__ws_7_ouvrage__nom__1
        rdf:type            ontolex:LexicalSense;
        dbnary:senseNumber  "7";
        skos:definition     [ rdf:value  "(Architecture) Toute sorte de travaux avancés au-dehors d’une place et destinés à la fortifier."@fr ];
        skos:example        [ rdf:value                      "Belgrade est une ville ouverte, car son ancienne forteresse turque ne peut pas être considérée comme un ouvrage de défense moderne."@fr;
                              dcterms:bibliographicCitation  "Rodolphe Archibald Reiss, Comment les Austro-Hongrois ont fait la guerre en Serbie, 1915"@fr
                            ] .

fra:__ws_8_ouvrage__nom__1
        rdf:type            ontolex:LexicalSense;
        dbnary:senseNumber  "8";
        skos:definition     [ rdf:value  "(Architecture, Maçonnerie) Construction."@fr ];
        skos:example        [ rdf:value                      "L’État a choisi le dossier Cofiroute et son tunnel de dix kilomètres à deux niveaux de circulation superposés réservé aux seuls véhicules légers : les poids lourds n’emprunteront pas l’ouvrage, ils auront le leur."@fr;
                              dcterms:bibliographicCitation  "Denis Lemarié, Chroniques de Versailles : Janvier à juillet 2005, Éditions Publibook, 2005, page 181"@fr
                            ] .

