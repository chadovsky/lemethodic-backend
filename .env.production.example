# F-078 — Production environment variables.
#
# This file documents what production needs. Values are NOT set here
# in production — they're set in the DO App Platform console as
# encrypted SECRET-typed env vars. This file is checked in for
# reference and onboarding; .env (local-only) is gitignored as
# always.
#
# For local dev with the Spaces backend live (Mode 1 verification —
# Step 8 of F-078), copy this file to .env and fill in the SECRET
# values. Without DO_SPACES_BUCKET set, the app falls through to the
# local-disk backend automatically.

# ── Database (auto-injected by App Platform from the bound DB) ──
# Locally: postgresql+psycopg://fluentpath:fluentpath_local_dev@localhost:5432/fluentpath
DATABASE_URL=

# ── Auth ────────────────────────────────────────────────────────
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# ── AI APIs ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
ASSEMBLYAI_API_KEY=

# ── Storage — DO Spaces ─────────────────────────────────────────
# When DO_SPACES_BUCKET is set, every persistent file write
# (audio uploads + TTS cache) goes to Spaces via boto3. Unset →
# local-disk fallback under STORAGE_LOCAL_ROOT.
DO_SPACES_BUCKET=fluentpath-storage
DO_SPACES_REGION=fra1
DO_SPACES_KEY=
DO_SPACES_SECRET=

# ── CORS ────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins. localhost dev
# origins are always allowed; this var only adds production /
# staging origins. Updated when F-079 ships the Vercel deploy.
FRONTEND_ORIGIN=

# ── Local-disk fallback root (only used when DO_SPACES_BUCKET unset) ──
# STORAGE_LOCAL_ROOT=./storage
