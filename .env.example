# ── App
APP_NAME=TCF Oral Practice Tool
DEBUG=true
SECRET_KEY=CHANGE-ME-IN-PRODUCTION-USE-openssl-rand-hex-32

# ── Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://tcf_user:tcf_pass@localhost:5432/tcf_oral

# ── Deepgram STT
DEEPGRAM_API_KEY=your-deepgram-api-key

# ── Anthropic (Claude API for Les Moules analysis)
ANTHROPIC_API_KEY=your-anthropic-api-key

# ── OpenAI (F-052: AI examiner voice via TTS-1-HD)
OPENAI_API_KEY=your-openai-api-key
# Optional overrides. Defaults: openai / nova (Tâche 1) / echo (Tâche 2).
# TTS_PROVIDER=openai
# TTS_VOICE_TACHE_1=nova
# TTS_VOICE_TACHE_2=echo
# TTS_CACHE_DIR=data/tts_cache
# TTS_COST_LOG=data/tts_cost.log

# ── S3-compatible storage (DigitalOcean Spaces)
S3_ENDPOINT=https://ams3.digitaloceanspaces.com
S3_BUCKET=tcf-audio
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key

# ── JWT
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
